SUPABASE_URL=###
SUPABASE_KEY=###

# Service-role (secret) key. Required ONLY for admin participant creation
# (auth.admin.createUser). It bypasses RLS — keep it server-only; it must NEVER
# reach the client. Locally it's the `service_role` / "Secret" key printed by
# `npx supabase start` (set it in .dev.vars for the Worker dev runtime).
SUPABASE_SERVICE_ROLE_KEY=###

# Local-dev admin seed (consumed by `npm run db:start` / `npm run db:reset`).
# The seed generator templates these into supabase/seed.sql (gitignored).
ADMIN_EMAIL=admin@betcup.local
ADMIN_PASSWORD=change-me-locally