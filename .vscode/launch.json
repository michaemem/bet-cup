{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "name": "Dev server (start DB first)",
      "request": "launch",
      "type": "node-terminal",
      "command": "npm run dev",
