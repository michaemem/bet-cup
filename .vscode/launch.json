    },
    {
      "name": "Vitest: unit tests",
      "request": "launch",
      "type": "node-terminal",
      "command": "npm test"
    },
    {
      "name": "Playwright: e2e",
      "request": "launch",
      "type": "node-terminal",
      "command": "npm run e2e",
      "preLaunchTask": "Supabase: Start + sync env"
    }
  ]
}
