-- Local-dev admin seed TEMPLATE (committed).
-- The generator (scripts/seed-template.mjs) substitutes {{ADMIN_EMAIL}} and
-- {{ADMIN_PASSWORD}} from .env into supabase/seed.sql (gitignored), which
-- `supabase start` / `supabase db reset` then applies.
--
-- Admin promotion is made DETERMINISTIC by the explicit user_roles insert at the
-- bottom of this file — it does not depend on trigger timing. The set_config
-- below is a best-effort FALLBACK that lets the handle_new_user trigger also
-- promote the admin when it can observe app.admin_email in-session; both paths
-- dedupe via UNIQUE(user_id, role) + `on conflict do nothing`.
-- WHY the explicit insert exists: set_config(..., false) is session-scoped, so it
-- only reaches the trigger if the CLI applies the whole seed in ONE connection.
-- Newer Supabase CLIs apply seed.sql via a batched/multi-statement executor where
-- that assumption no longer holds, silently skipping the admin row (the admin is
-- created but never promoted → later `permission denied` on admin-only inserts).
-- NOTE: the local seeding role is not a superuser and cannot run
-- `ALTER DATABASE ... SET` (permission denied, SQLSTATE 42501), so persisting the
-- GUC across connections is intentionally NOT done here. The production bootstrap
-- (README) runs the ALTER DATABASE in Studio under a privileged connection.

select set_config('app.admin_email', '{{ADMIN_EMAIL}}', false);

-- GoTrue verifies email/password through an auth.identities row, not just
-- auth.users. Insert both in one statement (CTE) so the identity reuses the
-- generated user id. The auth.users insert fires handle_new_user (profile +
-- role rows) before the identities insert runs.
with new_admin as (
  insert into auth.users (
    instance_id,
    id,
    aud,
    role,
    email,
    encrypted_password,
    email_confirmed_at,
    recovery_sent_at,
    last_sign_in_at,
    raw_app_meta_data,
    raw_user_meta_data,
    created_at,
    updated_at,
    confirmation_token,
    email_change,
    email_change_token_new,
    recovery_token
  ) values (
    '00000000-0000-0000-0000-000000000000',
    gen_random_uuid(),
    'authenticated',
    'authenticated',
    '{{ADMIN_EMAIL}}',
    crypt('{{ADMIN_PASSWORD}}', gen_salt('bf', 10)),
    now(),
    now(),
    now(),
    '{"provider":"email","providers":["email"]}',
    jsonb_build_object('display_name', 'Admin'),
    now(),
    now(),
    '',
    '',
    '',
    ''
  )
  on conflict do nothing
  returning id, email
)
insert into auth.identities (
  provider_id,
  user_id,
  identity_data,
  provider,
  last_sign_in_at,
  created_at,
  updated_at
)
select
  id::text,
  id,
  jsonb_build_object('sub', id::text, 'email', email, 'email_verified', true, 'phone_verified', false),
  'email',
  now(),
  now(),
  now()
from new_admin
on conflict do nothing;

-- Deterministic admin promotion: grant the admin role directly, independent of
-- whether the handle_new_user trigger observed app.admin_email in-session. Runs
-- in the same privileged context as the auth.users insert above; UNIQUE(user_id,
-- role) + `on conflict do nothing` dedupes against the trigger's own attempt.
insert into public.user_roles (user_id, role)
select id, 'admin' from auth.users where email = '{{ADMIN_EMAIL}}'
on conflict do nothing;
