---
import Layout from "@/layouts/Layout.astro";

const { user, profile } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{profile?.displayName ?? user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/predictions"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
        >
          My predictions
        </a>
        <a
          href="/leaderboard"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
        >
          Leaderboard
        </a>
        <a
          href="/history"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
        >
          My history
        </a>
        <a
          href="/settings"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
        >
          Settings
        </a>
      </div>
      {
        profile?.roles.includes("admin") && (
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a
              href="/admin"
              class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
            >
              Tournament admin
            </a>
            <a
              href="/admin/participants"
              class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
            >
              Participants
            </a>
          </div>
        )
      }
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm transition-colors hover:bg-white/20 sm:inline-block sm:w-auto"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
